# 环境变量清单与说明。
#
# ⚠️ 本程序**不会**自动读取 .env 文件（没有引入 dotenv），本文件只是变量名的参照表。
#    要生效请把它们设进进程环境：
#      Windows  PowerShell:  $env:BOT_WEBUI_PORT = "3090"        （当前会话）
#                            setx BOT_WEBUI_PORT "3090"          （写入用户环境，需重开终端）
#      Linux/macOS:          export BOT_WEBUI_PORT=3090
#    或者直接在启动脚本里设置。
#
# 绝大多数配置走 config.py，也可以在 Web 控制台「配置」页里改。
# 通常环境变量优先级高于 config.py；共享密码例外：已保存的 WEBUI_CONFIG.token 优先。

# --- Web 控制台 ---
# BOT_WEBUI_HOST=127.0.0.1
# BOT_WEBUI_PORT=3090
# BOT_WEBUI_TOKEN=  # 仅在 config.py 的共享密码为空时用于首次引导

# --- Oopz ---
# 覆盖 config.py 里的 OOPZ_CONFIG["proxy"]；空字符串跟随系统代理，direct 强制直连
# BOT_OOPZ_PROXY=http://127.0.0.1:7890
# 无 config.py 时的最小凭据来源（优先级高于 config.py）
# OOPZ_PHONE=
# OOPZ_PASSWORD=
# OOPZ_LOGIN_METHOD=phone

# --- OneBot v11 反向 WebSocket ---
# 覆盖 config.py 里的 ws_reverse_url
# BOT_ONEBOT_REVERSE_URL=ws://127.0.0.1:6200/ws
# 强制开关（覆盖 config.py 的 enabled）
# ONEBOT_V11_ENABLED=1

# --- 语音对话（VOICE_AGENT_CONFIG）---
# 覆盖 config.py 里对应的 api_key
# GEMINI_API_KEY=
# MIMO_API_KEY=
# OPENAI_API_KEY=
# 语音 API 与 WebUI 共用 BOT_WEBUI_TOKEN / WEBUI_CONFIG.token，已移除独立 VOICE_API_TOKEN。
# 指定 Chromium 可执行文件（未装 Playwright 自带浏览器时用）
# BOT_CHROMIUM_EXECUTABLE_PATH=
# CHROME_BIN=

# --- 日志 ---
# BOT_LOG_FILE_LEVEL=DEBUG
# BOT_LOG_CONSOLE_LEVEL=INFO
# BOT_SDK_LOG_LEVEL=INFO

# --- 网络代理（标准变量，config 的 proxy 留空时按序回退到它们）---
# ALL_PROXY=
# HTTPS_PROXY=
# HTTP_PROXY=
