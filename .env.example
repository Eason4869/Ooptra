# 复制为 .env 后按需修改；这里只有桥接与 Web 控制台会读的环境变量。
# 绝大多数配置走 config.py（也可以在 Web 控制台「配置」页里改）。

# --- Web 控制台 ---
# BOT_WEBUI_HOST=127.0.0.1
# BOT_WEBUI_PORT=3090
# BOT_WEBUI_TOKEN=

# --- Oopz ---
# 覆盖 config.py 里的 OOPZ_CONFIG["proxy"]；留空字符串表示直连，未设置则用系统代理
# BOT_OOPZ_PROXY=http://127.0.0.1:7890

# --- OneBot v11 反向 WebSocket ---
# 覆盖 config.py 里的 ws_reverse_url
# BOT_ONEBOT_REVERSE_URL=ws://127.0.0.1:6200/ws
# 强制开关（覆盖 config.py 的 enabled）
# ONEBOT_V11_ENABLED=1

# --- 日志 ---
# BOT_LOG_FILE_LEVEL=DEBUG
# BOT_LOG_CONSOLE_LEVEL=INFO
# BOT_SDK_LOG_LEVEL=INFO

# --- Python 环境（仅一键脚本使用）---
# PYTHON_BIN=python3
# VENV_DIR=.venv
